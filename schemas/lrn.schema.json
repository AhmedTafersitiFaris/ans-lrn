{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id","version","status","title","creator","scope","trigger","procedure","evidence","negative_evidence","limitations","stop_conditions","validation_event_ids"],
  "properties": {
    "id": {"type":"string","pattern":"^(LRN-[A-Z0-9-]+|EXAMPLE-NOT-VALIDATED)$"},
    "version": {"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "status": {"enum":["proposed","testing","validated","active","monitoring","revalidation","correction","suspended","retired","example_not_validated"]},
    "title":{"type":"string"}, "creator":{"type":"object","required":["id"]},
    "scope":{"type":"string"}, "trigger":{"type":"string"},
    "procedure":{"type":"array","minItems":1}, "evidence":{"type":"array","minItems":1},
    "negative_evidence":{"type":"array","minItems":1}, "limitations":{"type":"array","minItems":1},
    "stop_conditions":{"type":"array","minItems":1}, "validation_event_ids":{"type":"array"}
  }, "additionalProperties": false
}
